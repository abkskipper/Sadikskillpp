# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRADEGUARD_GEMINI_MODEL: Pinned stable Gemini production model for TradeGuard chart analysis.
TRADEGUARD_GEMINI_MODEL="gemini-3.8-flash"

# Optional Secondary Provider Failover (used only if primary Gemini key fails/unavailable)
# SECONDARY_GEMINI_API_KEY=""
# SECONDARY_PROVIDER_URL=""
# SECONDARY_PROVIDER_API_KEY=""
# SECONDARY_PROVIDER_MODEL=""

# Optional HMAC signing key for server session tokens (ephemeral CSPRNG fallback if omitted)
# TRADEGUARD_AUTH_SECRET=""
